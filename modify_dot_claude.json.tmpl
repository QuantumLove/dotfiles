#!/bin/bash
# Declaratively manage MCP servers in ~/.claude.json
# This script merges our MCP server configs while preserving all other data.
# Hash: {{ include "private_dot_claude/mcp-servers.yaml" | sha256sum }}
set -euo pipefail

# Read current file from stdin
current="$(cat)"

# If file doesn't exist or is empty, start with minimal structure
if [ -z "$current" ] || [ "$current" = "{}" ]; then
    current='{"mcpServers":{}}'
fi

# Source secrets_env if it exists (container entrypoint injects token there)
[ -f "$HOME/.secrets_env" ] && . "$HOME/.secrets_env"

# Check if 1Password is available and working - FAIL LOUDLY if not
if ! command -v op &> /dev/null; then
    echo "ERROR: op CLI not installed - cannot configure MCP servers" >&2
    exit 1
fi

if ! op account get &>/dev/null; then
    echo "ERROR: 1Password not authenticated - cannot configure MCP servers" >&2
    echo "  Set OP_SERVICE_ACCOUNT_TOKEN or source ~/.secrets_env" >&2
    exit 1
fi

# 1Password is working - load secrets.
#
# Every read below used to be unguarded under `set -euo pipefail`, so a single
# renamed or missing vault item aborted this script, which aborted `chezmoi
# apply`, which aborted the container boot. One absent MCP credential should
# disable one MCP server, not stop the machine from starting.
#
# A missing token is reported by name and leaves that server unconfigured; the
# mcp-servers-connected check is what surfaces it afterwards.
MISSING_TOKENS=()
# Assigns via printf -v rather than returning on stdout. A $(read_token ...)
# form runs the function in a subshell, so MISSING_TOKENS+= there never reaches
# the parent and the warning below is permanently empty — the failure report
# would have been silently unreachable.
read_token() { # <env-var> <op-path> <server>
    local var="$1" path="$2" server="$3" value
    [ -n "${!var:-}" ] && return 0
    if ! value="$(op read "$path" 2>/dev/null)" || [ -z "$value" ]; then
        MISSING_TOKENS+=("$server")
        printf -v "$var" '%s' ''
        return 0
    fi
    printf -v "$var" '%s' "$value"
}

read_token LINEAR_API_KEY               "op://Development/Linear MCP API Key/credential"          linear
read_token SENTRY_ACCESS_TOKEN          "op://Development/Sentry MCP API Key/credential"          sentry
read_token GITHUB_PERSONAL_ACCESS_TOKEN "op://Development/GitHub Personal Access Token/credential" github
read_token TOGGL_API_KEY                "op://Development/Toggl API Key/credential"               toggl
read_token SLACK_MCP_XOXP_TOKEN         "op://Development/Slack User OAuth Token/credential"      slack-read
read_token SLACK_MCP_XOXB_TOKEN         "op://Development/Slack Bot OAuth Token/credential"       slack-write
read_token DD_API_KEY                   "op://Development/Datadog API Key/credential"             datadog
read_token DD_APP_KEY                   "op://Development/Datadog App Key/credential"             datadog

if [ ${#MISSING_TOKENS[@]} -gt 0 ]; then
    echo "⚠️  MCP credentials unavailable — these servers will not connect: ${MISSING_TOKENS[*]}" >&2
fi

# Define our MCP servers (source of truth)
mcp_servers='{{ include "private_dot_claude/mcp-servers.yaml" | sha256sum }}'
desired_servers='{
  "linear": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@larryhudson/linear-mcp-server"],
    "env": {
      "LINEAR_API_KEY": "'"${LINEAR_API_KEY}"'"
    }
  },
  "fetch": {
    "type": "stdio",
    "command": "uvx",
    "args": ["mcp-server-fetch"],
    "env": {}
  },
  "pypi-query": {
    "type": "stdio",
    "command": "uvx",
    "args": ["--from", "pypi-query-mcp-server", "pypi-query-mcp"],
    "env": {
      "PYPI_INDEX_URL": "https://pypi.org/pypi",
      "PYPI_CACHE_TTL": "3600"
    }
  },
  "sentry": {
    "type": "stdio",
    "command": "npx",
    "args": ["@sentry/mcp-server@latest"],
    "env": {
      "SENTRY_ACCESS_TOKEN": "'"${SENTRY_ACCESS_TOKEN}"'",
      "SENTRY_ORG": "metr-sh"
    }
  },
  "github": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-github"],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "'"${GITHUB_PERSONAL_ACCESS_TOKEN}"'"
    }
  },
  "toggl": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@verygoodplugins/mcp-toggl@latest"],
    "env": {
      "TOGGL_API_KEY": "'"${TOGGL_API_KEY}"'"
    }
  },
  "slack-read": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "slack-mcp-server"],
    "env": {
      "SLACK_MCP_XOXP_TOKEN": "'"${SLACK_MCP_XOXP_TOKEN}"'"
    }
  },
  "slack-write": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "slack-mcp-server"],
    "env": {
      "SLACK_MCP_XOXB_TOKEN": "'"${SLACK_MCP_XOXB_TOKEN}"'",
      "SLACK_MCP_ADD_MESSAGE_TOOL": "true"
    }
  },
  "datadog": {
    "type": "stdio",
    "command": "uvx",
    "args": ["--from", "git+https://github.com/shelfio/datadog-mcp.git", "datadog-mcp"],
    "env": {
      "DD_API_KEY": "'"${DD_API_KEY}"'",
      "DD_APP_KEY": "'"${DD_APP_KEY}"'",
      "DD_SITE": "us3.datadoghq.com"
    }
  }
}'

# Merge our servers into existing mcpServers (preserves any user-added servers).
# Drop the legacy single "slack" instance, now split into slack-read / slack-write.
echo "$current" | jq --argjson servers "$desired_servers" '
  .mcpServers = (((.mcpServers // {}) | del(.slack)) * $servers)
'
