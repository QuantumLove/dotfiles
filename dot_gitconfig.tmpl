[user]
	email = quantumlove42@gmail.com
	name = Rafael

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

# --- Commit signing (SSH, via the 1Password SSH agent) ---------------------
# Signs every commit/tag with the "Base key" ed25519 key. The private half never
# leaves 1Password; git signs through the agent (SSH_AUTH_SOCK), so this works
# identically on the macOS host and inside the mega-container. The public key is
# registered on GitHub as a *signing* key, which is what makes commits show as
# "Verified". allowedSignersFile lets `git log --show-signature` verify locally.
[gpg]
	format = ssh

[user]
	signingkey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGv+Lz/wLKB1r8mbjMeE/L081ftbI7P5w534FrhSnUkv"

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

# gh manages HTTPS credentials for github.com (added by `gh auth setup-git`).
# Bare `gh` (not an absolute path) keeps this portable between the macOS host
# and the Linux container. The empty first `helper =` resets any inherited value.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
