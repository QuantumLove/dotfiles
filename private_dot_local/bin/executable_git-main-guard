#!/usr/bin/env bash
# git-main-guard — enforce two invariants for AI agents (and humans):
#
#   1. The PRIMARY worktree stays on main. Never edit files there (it must stay
#      pristine), and never switch it off main. Feature work goes in a linked
#      worktree (see /setup-work).
#   2. Scratch / gitignored paths (e.g. .omo/ plans, drafts, evidence) are
#      always writable, even in the main checkout — they never enter a commit.
#
# Shared core called by both the Claude Code hooks (guard-no-main-edits.sh,
# guard-no-main-checkout.sh) and the opencode claude-code-hooks bridge, so the
# git logic lives in exactly one place.
#
# Usage:
#   git-main-guard edit     --path <file>
#   git-main-guard checkout --command <cmd> [--cwd <dir>]
#   git-main-guard commit   [--cwd <dir>]
#   git-main-guard push     --remote <name-or-url> [--cwd <dir>]   # refs on stdin
#
# Exit 0 = allow (silent).  Exit 2 = block (human-readable reason on stderr).
#
# There is no environment bypass. `--no-verify` is the sanctioned escape hatch
# for the git-hook rules; the primary-worktree rule has none by design.
#
# Known scope (by design, not bugs): file protection covers the Edit/Write
# tools, not arbitrary shell writes (sed -i, redirection). The checkout guard
# is best-effort string analysis of common forms; it does not chase deliberate
# evasion (git -C <other>, GIT_DIR=, subshells). It is a guardrail against
# accidental agent behavior, not a security boundary.

set -uo pipefail

# The policy lives in one file that every enforcement point reads — the git
# hooks and the per-harness adapters alike. Identity is a remote slug, so a
# clone at any path resolves the same way.
POLICY_FILE="${GIT_GUARD_POLICY:-$HOME/.config/git-guard/policy.json}"
GUARD_LOG="$HOME/.local/state/git-guard.log"

guard_log() { # <reason>
    mkdir -p "$(dirname "$GUARD_LOG")" 2>/dev/null
    printf '[%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" >> "$GUARD_LOG" 2>/dev/null
}

# A missing policy is not an allow: it means the guard is disarmed, which the
# assertion suite has to be able to see. Exit 3 is distinct from both allow (0)
# and block (2) so callers can tell the difference.
if [ ! -r "$POLICY_FILE" ]; then
    guard_log "policy file unreadable: $POLICY_FILE"
    echo "git-main-guard: policy file unreadable: $POLICY_FILE" >&2
    exit 3
fi

ALLOW_REMOTES=()
while IFS= read -r _slug; do
    [ -n "$_slug" ] && ALLOW_REMOTES+=("$_slug")
done < <(jq -r '.exempt_remotes[]?' "$POLICY_FILE" 2>/dev/null)

MODE="${1:-}"
shift || true

PATH_ARG=""
CMD_ARG=""
CWD_ARG="$PWD"
REMOTE_ARG="origin"
while [ $# -gt 0 ]; do
    case "$1" in
        --path)    PATH_ARG="${2:-}"; shift 2 || shift ;;
        --command) CMD_ARG="${2:-}";  shift 2 || shift ;;
        --cwd)     CWD_ARG="${2:-}";  shift 2 || shift ;;
        --remote)  REMOTE_ARG="${2:-}"; shift 2 || shift ;;
        *)         shift ;;
    esac
done

# No environment bypass. ALLOW_MAIN_EDITS and CLAUDE_ALLOW_MAIN_EDITS are
# retired: a variable that disables the guard everywhere, set once during a
# frustrating session and left, is how enforcement quietly decays.

# --- helpers ----------------------------------------------------------------

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# Canonicalize an existing directory to an absolute, symlink-resolved path.
abspath_dir() { # <dir>
    ( cd "$1" 2>/dev/null && pwd -P ) || printf '%s' "$1"
}

normalize_remote() { # <url> -> owner/repo (lowercased); host-agnostic
    local url="$1" owner repo rest
    url="${url%.git}"
    url="${url%/}"
    repo="${url##*/}"          # last path segment
    rest="${url%/*}"           # everything before the last '/'
    owner="${rest##*[:/]}"     # segment after the last ':' or '/'
    lower "$owner/$repo"
}

repo_is_allowlisted() { # <repo_root> [remote_name]
    # Identity comes from the remote being operated on, not a hardcoded origin
    # and not the filesystem path. `git push fork main` in a repo whose origin
    # is exempt must not inherit that exemption.
    local root="$1" remote="${2:-origin}"
    local url slug a
    url="$(git -C "$root" remote get-url "$remote" 2>/dev/null || echo "")"
    [ -z "$url" ] && return 1
    slug="$(normalize_remote "$url")"
    for a in "${ALLOW_REMOTES[@]-}"; do
        [ -n "$a" ] && [ "$slug" = "$(lower "$a")" ] && return 0
    done
    return 1
}

default_branch() { # <repo_root> [remote_name] — empty when underivable
    # Offline only. `git ls-remote` would be authoritative but puts a network
    # round-trip on every commit, which breaks committing without a network.
    local root="$1" remote="${2:-origin}" ref
    ref="$(git -C "$root" symbolic-ref --short -q "refs/remotes/$remote/HEAD" 2>/dev/null || echo "")"
    [ -n "$ref" ] && { printf '%s' "${ref#"$remote"/}"; return 0; }
    printf ''
}

has_remote() { # <repo_root>
    [ -n "$(git -C "$1" remote 2>/dev/null | head -1)" ]
}

is_primary_worktree() { # <dir> — true iff dir belongs to the main checkout
    # --absolute-git-dir (git 2.13+) avoids the git-2.31-only --path-format flag.
    local gd cd_
    gd="$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null || echo "")"
    cd_="$(git -C "$1" rev-parse --git-common-dir 2>/dev/null || echo "")"
    [ -n "$gd" ] && [ -n "$cd_" ] || return 1
    case "$cd_" in /*) ;; *) cd_="$1/$cd_" ;; esac   # common-dir may be relative
    [ "$(abspath_dir "$gd")" = "$(abspath_dir "$cd_")" ]
}

current_branch() { # <dir> — empty on detached HEAD; portable (no --show-current)
    git -C "$1" symbolic-ref --short -q HEAD 2>/dev/null || echo ""
}

# Does a `git checkout`/`git switch` command move HEAD (branch/ref switch) as
# opposed to restoring files (`git checkout -- <path>`, `git checkout .`)?
# Scans EVERY git invocation in the command (compound `a && b`), returning 0 if
# any one moves HEAD.
command_moves_head() { # <command> <repo_root>
    local cmd="$1" root="$2"
    local -a toks
    read -ra toks <<<"$cmd"
    local n=${#toks[@]} i j

    for ((i = 0; i < n; i++)); do
        [ "${toks[i]}" = "git" ] || continue

        # Find this invocation's subcommand, skipping global options.
        local verb="" gi=-1
        j=$((i + 1))
        while [ $j -lt $n ]; do
            case "${toks[j]}" in
                -C|-c|--git-dir|--work-tree|--namespace|--super-prefix|--config-env)
                    j=$((j + 2)); continue ;;                    # space-form opt + value
                --git-dir=*|--work-tree=*|--namespace=*|-*)
                    j=$((j + 1)); continue ;;                    # attached-value / other opts
                checkout|switch) verb="${toks[j]}"; gi=$j; break ;;
                *) break ;;                                      # a different subcommand
            esac
        done
        [ -n "$verb" ] || continue

        # switch always moves HEAD (there is no file-restore form).
        [ "$verb" = "switch" ] && return 0

        # checkout: inspect args up to the next shell separator.
        local -a positional=()
        local k has_ddash=0
        for ((k = gi + 1; k < n; k++)); do
            case "${toks[k]}" in
                "&&"|"||"|";"|"|"|"&") break ;;                  # end of this invocation
                --) has_ddash=1; break ;;
                -b|-B|--detach|--orphan) return 0 ;;             # creates/detaches -> moves HEAD
                -) return 0 ;;                                   # `checkout -` -> previous branch
                -*) ;;                                           # other flags: ignore
                *) positional+=("${toks[k]}") ;;
            esac
        done

        [ $has_ddash -eq 1 ] && continue                        # `checkout -- <path>` -> restore
        [ ${#positional[@]} -eq 0 ] && continue                 # bare `checkout` -> no move

        # If any positional resolves to a ref, this invocation switches HEAD.
        local a
        for a in "${positional[@]}"; do
            if git -C "$root" rev-parse --verify --quiet "${a}^{commit}" >/dev/null 2>&1; then
                return 0
            fi
        done
        # positional args are paths (restore) -> safe; keep scanning other invocations
    done
    return 1
}

# --- modes ------------------------------------------------------------------

case "$MODE" in
    edit)
        { [ -z "$PATH_ARG" ] || [ "$PATH_ARG" = "null" ]; } && exit 0

        # Make the path absolute up front. The git queries below run with -C
        # "$root", which would otherwise resolve a relative path against the repo
        # root instead of the caller's directory and inspect the wrong file.
        case "$PATH_ARG" in
            /*) ;;
            *)  PATH_ARG="$PWD/$PATH_ARG" ;;
        esac

        # Resolve the repo from the nearest EXISTING ancestor dir, so a new file
        # in a not-yet-created subdir still resolves its repo (no fail-open gap).
        dir="$(dirname "$PATH_ARG")"
        while [ -n "$dir" ] && [ "$dir" != "/" ] && [ ! -d "$dir" ]; do
            dir="$(dirname "$dir")"
        done
        [ -d "$dir" ] || dir="."
        root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || echo "")"
        [ -z "$root" ] && exit 0                       # not in a git repo -> allow
        repo_is_allowlisted "$root" && exit 0

        # (A) scratch / gitignored paths are always writable — never committed.
        case "$PATH_ARG" in
            */.omo/*|*/.omo|.omo/*|.omo) exit 0 ;;
        esac
        if git -C "$root" check-ignore -q "$PATH_ARG" 2>/dev/null; then
            exit 0
        fi

        # (A2) only TRACKED files block. An untracked path cannot be in a commit
        # without someone first adding it, and the commit hook covers that. This
        # also keeps agent tool-call pseudo-paths (omp addresses its tools as
        # xd://<tool>, which is not a file at all) from reading as a repo write.
        git -C "$root" ls-files --error-unmatch -- "$PATH_ARG" >/dev/null 2>&1 || exit 0

        # (B) block edits to tracked files in the PRIMARY worktree, whatever
        #     branch it is on (a feature branch there is itself the bug).
        if is_primary_worktree "$root"; then
            br="$(current_branch "$root")"
            cat >&2 <<EOF
Blocked: refusing to edit files in the primary (main) checkout.
  Repo:   $root
  File:   $PATH_ARG
  Branch: ${br:-<detached>}

The primary checkout must stay on main and stay clean. Use a worktree:
  /setup-work <linear-id-or-description>

Scratch/gitignored paths (e.g. .omo/) are exempt — only tracked files block.
EOF
            exit 2
        fi
        exit 0                                         # linked worktree -> allow
        ;;

    checkout)
        { [ -z "$CMD_ARG" ] || [ "$CMD_ARG" = "null" ]; } && exit 0
        case "$CMD_ARG" in
            *git*checkout*|*git*switch*) ;;
            *) exit 0 ;;
        esac
        [ -z "$CWD_ARG" ] && CWD_ARG="$PWD"
        root="$(git -C "$CWD_ARG" rev-parse --show-toplevel 2>/dev/null || echo "")"
        [ -z "$root" ] && exit 0
        repo_is_allowlisted "$root" && exit 0
        is_primary_worktree "$root" || exit 0          # only guard the main checkout
        br="$(current_branch "$root")"
        def_br="$(default_branch "$root")"
        if [ -z "$def_br" ]; then
            has_remote "$root" && guard_log "checkout: default branch underivable in $root — allowed"
            exit 0                                     # fail open, per the accident model
        fi
        # A detached HEAD is still the primary worktree being moved, so it is
        # evaluated rather than waved through.
        if [ -n "$br" ] && [ "$br" != "$def_br" ]; then
            exit 0                                     # already off default -> allow recovery
        fi

        if command_moves_head "$CMD_ARG" "$root"; then
            cat >&2 <<EOF
Blocked: refusing to switch the primary (main) checkout off '$br'.
  Repo:    $root
  Command: $CMD_ARG

The primary checkout must always stay on main — feature work goes in a worktree:
  /setup-work <branch-or-linear-id>

This rule has no bypass; move the work to a worktree.
EOF
            exit 2
        fi
        exit 0
        ;;

    commit)
        # Rule 2. Fires from pre-commit, so the repo is unambiguous — the hook
        # runs in the repo the commit targets, whatever the caller's cwd was.
        [ -z "$CWD_ARG" ] && CWD_ARG="$PWD"
        root="$(git -C "$CWD_ARG" rev-parse --show-toplevel 2>/dev/null || echo "")"
        [ -z "$root" ] && exit 0
        has_remote "$root" || exit 0                   # nothing shared to protect
        repo_is_allowlisted "$root" && exit 0
        def_br="$(default_branch "$root")"
        [ -z "$def_br" ] && { guard_log "commit: default branch underivable in $root — allowed"; exit 0; }
        br="$(current_branch "$root")"
        [ "$br" = "$def_br" ] || exit 0
        cat >&2 <<EOF
Blocked: refusing to commit on '$def_br'.
  Repo: $root

Branch first, then commit:
  git checkout -b <branch>

If you mean it: git commit --no-verify
EOF
        exit 2
        ;;

    push)
        # Rule 3. Ref lines arrive on stdin as:
        #   <local_ref> <local_sha> <remote_ref> <remote_sha>
        # remote_ref is authoritative — it is what makes `git push origin
        # feat:main` a push to main, which no command-string match would catch.
        [ -z "$CWD_ARG" ] && CWD_ARG="$PWD"
        root="$(git -C "$CWD_ARG" rev-parse --show-toplevel 2>/dev/null || echo "")"
        [ -z "$root" ] && exit 0
        has_remote "$root" || exit 0
        repo_is_allowlisted "$root" "$REMOTE_ARG" && exit 0
        def_br="$(default_branch "$root" "$REMOTE_ARG")"
        [ -z "$def_br" ] && { guard_log "push: default branch underivable for $REMOTE_ARG in $root — allowed"; exit 0; }

        blocked=""
        # `|| [ -n "$remote_ref" ]` so a final line with no trailing newline is
        # still processed rather than dropped at EOF.
        while read -r _local_ref _local_sha remote_ref _remote_sha || [ -n "${remote_ref:-}" ]; do
            [ -n "${remote_ref:-}" ] || continue
            [ "$remote_ref" = "refs/heads/$def_br" ] && blocked="$remote_ref"
        done
        [ -z "$blocked" ] && exit 0
        cat >&2 <<EOF
Blocked: refusing to push to '$def_br'.
  Repo:   $root
  Remote: $REMOTE_ARG
  Ref:    $blocked

Push a branch and open a PR. If you mean it: git push --no-verify
EOF
        exit 2
        ;;

    *)
        exit 0
        ;;
esac
