#!/usr/bin/env bash
# mega-doctor — health and correctness report for the mega-container.
#
# Usage:
#   mega-doctor              # everything except the slow behavioural checks
#   mega-doctor --quick      # same, minus anything that waits on the network
#   mega-doctor --deep       # include tier-3 behavioural checks
#   mega-doctor --no-mcp     # accepted for compatibility; the MCP probe is
#                            # tier 3 and already excluded unless --deep
#   mega-doctor -h
#
# The checks themselves live in mega-assert. This is the name the entrypoint and
# rebuild.sh call, so it keeps its flags and its exit contract: zero unless an
# invariant check failed. A failing liveness check is reported and never changes
# the exit code — a dead web UI must not stop the container starting.
set -uo pipefail

ASSERT="$HOME/.local/bin/mega-assert"

args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --quick)   args+=(--severity invariant) ;;   # skip the network probes
        --deep)    args+=(--deep) ;;
        --no-mcp)  ;;                                # no-op: mcp probe is tier 3
        -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
        *)         args+=("$1") ;;
    esac
    shift
done

# Checked after parsing so -h works on a machine where mega-assert is absent.
[ -x "$ASSERT" ] || { echo "mega-doctor: mega-assert not found at $ASSERT" >&2; exit 2; }

exec "$ASSERT" ${args+"${args[@]}"}
