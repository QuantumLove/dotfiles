#!/bin/bash
# PreToolUse hook: blocks Edit/Write/MultiEdit/NotebookEdit when the target
# file is a tracked file in the PRIMARY (main) checkout. Scratch/gitignored
# paths (e.g. .omo/) and linked worktrees are allowed. Forces a worktree flow.
#
# Thin adapter: all logic lives in ~/.local/bin/git-main-guard (shared with the
# opencode guard-main plugin). Bypass for one session: CLAUDE_ALLOW_MAIN_EDITS=1
# Allowlisted repos (main edits expected): chezmoi dotfiles, QuantumLove/glove80.

set -euo pipefail

HOOK_NAME="guard-no-main"
source "$HOME/.claude/hooks/hook-lib.sh"

payload="$(cat)"
tool_name="$(jq -r '.tool_name // ""' <<<"$payload" 2>/dev/null || echo "")"
hook_log "tool=$tool_name"

case "$tool_name" in
    Edit|Write|MultiEdit|NotebookEdit) ;;
    *) exit 0 ;;
esac

file_path="$(jq -r '.tool_input.file_path // .tool_input.notebook_path // ""' <<<"$payload" 2>/dev/null || echo "")"
if [ -z "$file_path" ] || [ "$file_path" = "null" ]; then
    hook_log "no file_path in tool_input — allowing"
    exit 0
fi

guard="$HOME/.local/bin/git-main-guard"
if [ ! -x "$guard" ]; then
    hook_log "core guard not installed at $guard — allowing (run chezmoi apply)"
    exit 0
fi

exec "$guard" edit --path "$file_path"
