#!/bin/bash
# Generate passthrough shims for every git hook we do not implement ourselves.
#
# hooks-hash: {{ include "private_dot_config/git/hooks/executable__chain.sh" | sha256sum }}
#
# A global core.hooksPath replaces a repo's entire .git/hooks directory, not
# just the hooks it shadows. Without a shim for each name, a work repo using
# husky or the pre-commit framework loses commit-msg, post-checkout, post-merge
# and the rest with no error — the breakage surfaces in CI, days later.
#
# This script does NOT set core.hooksPath. Installing the files is inert;
# activation is one line in dot_gitconfig.tmpl and is a separate, deliberate
# step, because it changes the behaviour of every git command on the machine.
set -euo pipefail

HOOK_DIR="$HOME/.config/git/hooks"
# Not a silent exit: if the directory is missing the guard hooks were not
# applied, and quietly succeeding here would leave the shims absent while
# reporting nothing.
if [ ! -d "$HOOK_DIR" ]; then
    echo "⚠️  $HOOK_DIR does not exist — guard hooks were not applied; no shims written" >&2
    exit 1
fi

# Client-side hooks git may invoke. pre-commit and pre-push are ours and are
# deliberately absent from this list.
SHIMMED=(
    applypatch-msg pre-applypatch post-applypatch
    commit-msg prepare-commit-msg post-commit
    pre-merge-commit pre-rebase post-checkout post-merge post-rewrite
    pre-auto-gc push-to-checkout sendemail-validate
    post-index-change reference-transaction
)

created=0
for name in "${SHIMMED[@]}"; do
    target="$HOOK_DIR/$name"
    cat > "$target" <<EOF
#!/usr/bin/env bash
# Passthrough shim — generated by run_onchange_after_install-git-hooks.
# Exists so a global core.hooksPath does not silently disable this hook in
# repos that define their own.
set -uo pipefail
. "\$(dirname "\$0")/_chain.sh"
chain_repo_hook $name "\$@"
EOF
    chmod +x "$target"
    created=$((created + 1))
done

echo "✅ git hook shims: $created passthrough hooks in $HOOK_DIR"
echo "   core.hooksPath is NOT set — hooks are installed but inactive."
