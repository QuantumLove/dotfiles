#!/bin/bash
# Fast validation of Claude Code configuration
# For full diagnostics, run: /claude-diagnostics
set -e

echo ""
echo "🔍 Claude Code - Quick Validation"
echo ""

WARN_COUNT=0
warn() { echo "⚠️  $1"; WARN_COUNT=$((WARN_COUNT + 1)); }

# ----------------------------------------
# REQUIRED: Claude CLI
# ----------------------------------------
if ! command -v claude &> /dev/null; then
    echo "❌ Claude Code not found. Please install it:"
    {{- if .is_macos }}
    echo "   macOS: brew install claude-code"
    {{- else if .is_devcontainer }}
    echo "   DevContainer: Add to devcontainer.json:"
    echo '   "features": { "ghcr.io/anthropics/devcontainer-features/claude-code:1": {} }'
    {{- else }}
    echo "   Linux: npm install -g @anthropics/claude-code"
    {{- end }}
    exit 1
fi
echo "✅ claude: $(claude --version 2>&1 | head -1)"

# ----------------------------------------
# REQUIRED: Git
# ----------------------------------------
if ! command -v git &> /dev/null; then
    echo "❌ git not found (required)"
    exit 1
fi

# ----------------------------------------
# REQUIRED: jq (hooks need it)
# ----------------------------------------
if ! command -v jq &> /dev/null; then
    warn "jq not found - hooks may not work correctly"
fi

# ----------------------------------------
# REQUIRED: Directory structure
# ----------------------------------------
for dir in ~/.claude ~/.claude/agents ~/.claude/commands; do
    if [ ! -d "$dir" ]; then
        echo "❌ $dir missing"
        exit 1
    fi
done
echo "✅ directories exist"

# ----------------------------------------
# REQUIRED: Valid settings.json
# ----------------------------------------
if [ ! -f ~/.claude/settings.json ]; then
    echo "❌ settings.json missing"
    exit 1
fi
if command -v jq &> /dev/null && ! jq empty ~/.claude/settings.json 2>/dev/null; then
    echo "❌ settings.json is not valid JSON"
    exit 1
fi
echo "✅ settings.json valid"

# ----------------------------------------
# COUNT: Agents and commands
# ----------------------------------------
AGENT_COUNT=$(find ~/.claude/agents -name "*.md" 2>/dev/null | wc -l | tr -d ' ')
COMMAND_COUNT=$(find ~/.claude/commands -name "*.md" 2>/dev/null | wc -l | tr -d ' ')
echo "✅ $AGENT_COUNT agents, $COMMAND_COUNT commands"

# ----------------------------------------
# VALIDATE: Frontmatter (fast check)
# ----------------------------------------
# A zero corpus and a clean corpus both used to exit quietly here: if the glob
# matched nothing, grep errored into /dev/null, wc counted 0, and no warning
# fired — so "0 agents, 0 commands" read exactly like a healthy install. Assert
# the corpus is non-empty before trusting a zero.
validate_frontmatter() { # <label> <dir>
    local label="$1" dir="$2" total invalid
    if [ ! -d "$dir" ]; then
        warn "$label directory missing: $dir"
        return
    fi
    total=$(find "$dir" -name "*.md" 2>/dev/null | wc -l | tr -d ' ')
    if [ "$total" -eq 0 ]; then
        warn "no $label files found in $dir — expected at least one"
        return
    fi
    invalid=$(grep -L "^name:" "$dir"/*.md 2>/dev/null | wc -l | tr -d ' ')
    if [ "$invalid" -gt 0 ]; then
        warn "$invalid of $total $label(s) missing 'name:' frontmatter"
    fi
}

validate_frontmatter agent   "$HOME/.claude/agents"
validate_frontmatter command "$HOME/.claude/commands"

# ----------------------------------------
# OPTIONAL: Quick checks (non-blocking)
# ----------------------------------------
{{- if .is_macos }}
if ! command -v terminal-notifier &> /dev/null; then
    warn "terminal-notifier not found - notifications won't work"
fi
{{- end }}

if ! command -v gh &> /dev/null || ! gh auth status &>/dev/null 2>&1; then
    warn "gh CLI not authenticated - run 'gh auth login'"
fi

# ----------------------------------------
# SUMMARY
# ----------------------------------------
echo ""
if [ $WARN_COUNT -gt 0 ]; then
    echo "⚠️  $WARN_COUNT warning(s) - run /claude-diagnostics for details"
else
    echo "✅ All checks passed"
fi
echo ""
